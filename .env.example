# Where your Ollama server lives. Gemma 3 4B is fast on modest hardware and follows a JSON schema well.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# How long Ollama keeps the model loaded after each request. Its own default is 5 minutes, then the next use is a cold start.
# OLLAMA_KEEP_ALIVE=30m
# ComfyUI, for making event pictures. The default is a ComfyUI on this machine.
COMFYUI_URL=http://localhost:8188
# Optional: pick a checkpoint by file name. By default a fast one (lightning/turbo) is used if there is one.
# COMFYUI_CHECKPOINT=dreamshaperXL_lightningDPMSDE.safetensors
# The address guests will use, so printed invites point at the right place (must be reachable from guests' phones).
# PUBLIC_BASE_URL=https://invites.example.com
# Public Overpass instance for OpenStreetMap lookups. Point at your own for fully offline planning.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Map on the new-event form. Tiles come from OpenStreetMap's public server by default, which sees the area you look at.
# MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# MAP_CENTER=43.07,-76.17,12
# Set to true when serving over HTTPS (required for NFC writing from a phone).
# COOKIE_SECURE=true
